    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs ."
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
