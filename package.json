{
  "name": "mega-skillstate",
  "version": "0.3.0",
  "private": true,
  "description": "OpenCode 2.0 plugin: bound the context window with an explicit, structured skill-execution state (SKILL.state) instead of append-only history",
  "type": "module",
  "main": "./server.ts",
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "server.ts",
    "src",
    "scripts",
    "options.json",
    "README.md"
  ],
  "license": "MIT",
  "author": "Evert Chin (https://github.com/megablue)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megablue/mega-skillstate.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs .",
    "plugin:install": "node scripts/install.ts",
    "plugin:install:project": "node scripts/install.ts --project",
    "plugin:uninstall": "node scripts/install.ts --remove",
    "plugin:status": "node scripts/install.ts --status"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
